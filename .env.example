MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=notesdb
# Token required by /api/backups* endpoints (leave empty to disable them)
ADMIN_TOKEN=change-me
BACKUP_DIR=./backups
BACKUP_KEEP=7
# Optional: copy every backup to an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO)
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
